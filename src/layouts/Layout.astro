---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cart from '../components/Cart.astro';
const { title = 'ARX SHOP | Plugins premium para Minecraft', description = 'Plugins premium para servidores de Minecraft desarrollados por ARX | STUDIO.' } = Astro.props;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><link rel="icon" href="/favicon.svg" /><meta name="description" content={description} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><title>{title}</title></head><body><Header /><main><slot /></main><Footer /><Cart /></body></html>
